---
/**
 * Iconos de enlace (16 × 16, decorativos: el texto del enlace ya da el nombre accesible).
 * github: marca oficial (Octicons). gmail: simple-icons (CC0). linkedin, email, website, source: dibujos propios.
 */
interface Props {
  name: 'github' | 'linkedin' | 'gmail' | 'email' | 'website' | 'source';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---
<svg class="icon" viewBox="0 0 16 16" width={size} height={size} aria-hidden="true" focusable="false">
  {name === 'github' && (
    <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
  )}
  {name === 'linkedin' && (
    <path fill="currentColor" fill-rule="evenodd" d="M3 1h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Zm1.2 5.3v6.2h2V6.3Zm1-3.2a1.15 1.15 0 1 0 0 2.3 1.15 1.15 0 0 0 0-2.3Zm2.9 3.2v6.2h2V9.2c0-.9.5-1.4 1.2-1.4s1 .5 1 1.4v3.3h2V8.8c0-1.8-1-2.7-2.4-2.7-.9 0-1.5.4-1.8.9v-.7Z" />
  )}
  {name === 'gmail' && (
    <path fill="currentColor" transform="scale(0.6667)" d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z" />
  )}
  {name === 'email' && (
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><rect x="1.5" y="3" width="13" height="10" rx="1.5" /><path d="M2 4l6 4.8L14 4" /></g>
  )}
  {name === 'website' && (
    <g fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="8" cy="8" r="6.3" /><path d="M1.7 8h12.6M8 1.7c1.9 1.9 2.7 4 2.7 6.3s-.8 4.4-2.7 6.3c-1.9-1.9-2.7-4-2.7-6.3S6.1 3.6 8 1.7Z" /></g>
  )}
  {name === 'source' && (
    <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5M9 3l-2 10" />
  )}
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
