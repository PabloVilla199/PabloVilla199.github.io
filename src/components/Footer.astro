---
/** Pie con el apartado Contacto (#contacto). Siempre accesible, también en móvil y sin JS. */
import type { CollectionEntry } from 'astro:content';
import ContactLinks from './ContactLinks.astro';
import { sectionIds, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile } = Astro.props;
const s = ui[lang];
const hasLinks = Object.values(profile.links).some(Boolean);
const year = new Date().getFullYear();
---
<footer class="footer" id={sectionIds[lang].contact} aria-labelledby="contact-title">
  <div class="page footer__contact">
    <h2 class="footer__title" id="contact-title">{s.contactTitle}</h2>
    <div class="footer__body">
      <ContactLinks lang={lang} links={profile.links} />
      {!hasLinks && !import.meta.env.DEV && <p class="meta">{s.noLinks}</p>}
      {!hasLinks && import.meta.env.DEV && (
        <p class="meta footer__hint">Aviso visible solo en desarrollo: añade correo, GitHub o LinkedIn en <code>src/content/profile.json</code>, dentro de <code>links</code>.</p>
      )}
    </div>
  </div>
  <div class="page footer__base">
    <p class="meta">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    border-top: var(--rule);
    background: var(--color-surface);
  }

  .footer__contact {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding-block: var(--space-8);
    text-align: center;
  }

  .footer__title {
    font-size: var(--text-h2);
  }

  .footer__body {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  .footer__hint {
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-text-soft);
    max-width: var(--measure);
  }

  .footer__base {
    padding-bottom: var(--space-5);
  }

  .footer__base p {
    padding-top: var(--space-5);
    border-top: var(--rule);
  }

</style>
