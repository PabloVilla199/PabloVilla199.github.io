---
/**
 * Logotipo «PV» (Pablo Villa): P angulosa en color texto con la punta afilada hacia abajo a la izquierda y
 * V en --color-accent con forma de marca de verificación, encajada bajo la panza de la P.
 * El resto del sitio solo lo usa a través de <Monogram />. El favicon (public/favicon.svg) repite esta
 * geometría con colores en hex, sobre una tesela oscura para que se vea en pestañas claras.
 *
 * Coordenadas de la imagen original (1254 × 1254); el viewBox recorta un cuadrado con un margen moderado.
 * El marcado es la forma final. Con `animated`, motion.ts hace entrar las dos piezas una vez (data-mono-piece).
 */
interface Props {
  /** Tamaño en CSS (p. ej. "1.75rem", "9rem"). */
  size?: string;
  /** Activa los ganchos de animación (solo el monograma grande de la portada). */
  animated?: boolean;
  /** Texto alternativo; si se omite, el monograma es decorativo (aria-hidden). */
  label?: string;
  class?: string;
}
const { size = '2rem', animated = false, label, class: className } = Astro.props;
const a = animated ? '' : undefined;
---
<svg
  class:list={['monogram', className]}
  viewBox="150 110 1013 1013"
  width="48"
  height="48"
  style={`--mono-size: ${size}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  data-mono-anim={a}
>
  <path
    class="monogram__ink"
    fill-rule="evenodd"
    d="M447 202H975L763 497L497 557L190 1005Z M565 297H790L735 380Q712 418 683 425L478 462L553 312Q558 298 565 297Z"
    data-mono-piece={a}
  />
  <path class="monogram__accent" d="M518 572L687 797L923 485H1123L690 1030L428 696Z" data-mono-piece={a} />
</svg>

<style>
  .monogram {
    display: block;
    flex: none;
    width: var(--mono-size);
    height: var(--mono-size);
    overflow: visible;
  }

  .monogram__ink {
    fill: var(--color-text);
  }

  .monogram__accent {
    fill: var(--color-accent);
  }
</style>
