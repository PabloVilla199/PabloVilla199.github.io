---
/**
 * Enlaces de contacto: fila centrada de iconos de marca con su nombre debajo (GitHub · LinkedIn · Gmail).
 * Todo el bloque (icono + nombre) es el enlace y se abre en una pestaña nueva; no se muestran URLs ni la
 * dirección de correo. Gmail abre la pantalla de redactar de Gmail con la dirección ya puesta (un enlace
 * mailto: depende de que el visitante tenga un cliente de correo configurado).
 * Solo aparecen los enlaces configurados en profile.json. La usan el pie y el panel lateral.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  links: CollectionEntry<'profile'>['data']['links'];
}
const { lang, links } = Astro.props;
const labels = ui[lang].contactLabels;
const newTab = ui[lang].newTab;

const items: { icon: 'github' | 'linkedin' | 'gmail'; label: string; href: string }[] = [];
if (links.github) items.push({ icon: 'github', label: labels.github, href: links.github });
if (links.linkedin) items.push({ icon: 'linkedin', label: labels.linkedin, href: links.linkedin });
if (links.email) {
  const compose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(links.email)}`;
  items.push({ icon: 'gmail', label: labels.email, href: compose });
}
---
{items.length > 0 && (
  <ul class="contact-icons">
    {items.map((l) => (
      <li>
        <a class="contact-icons__link" href={l.href} target="_blank" rel={l.icon === 'gmail' ? 'noopener noreferrer' : 'me noopener noreferrer'}>
          <Icon name={l.icon} size={28} />
          <span class="contact-icons__name mono">{l.label}</span>
          <span class="visually-hidden">{newTab}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .contact-icons {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-icons__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 4.5rem;
    padding: var(--space-3) var(--space-3) var(--space-2);
    border-radius: 4px;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--motion-fast) ease, background-color var(--motion-fast) ease;
  }

  .contact-icons__name {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
    transition: color var(--motion-fast) ease;
  }

  .contact-icons__link:hover,
  .contact-icons__link:focus-visible {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .contact-icons__link:hover .contact-icons__name,
  .contact-icons__link:focus-visible .contact-icons__name {
    color: var(--color-accent);
  }
</style>
