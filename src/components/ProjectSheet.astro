---
/**
 * Ficha de un proyecto con su pestaña activa.
 *  - variant "full": página propia (/es/proyectos/<id>/, /en/projects/<id>/): resumen, apartado propio
 *    (`highlight`, si existe), contexto, aportaciones, tecnologías con icono y enlaces.
 *  - variant "compact": portada (proyectos destacados): resumen, tecnologías, enlaces y acceso a la ficha.
 * Se omiten la imagen, el apartado, el contexto o los enlaces que no estén configurados.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import TechList from './TechList.astro';
import { projectUrl, t, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  variant?: 'full' | 'compact';
}
const { lang, project, variant = 'full' } = Astro.props;
const s = ui[lang];
const p = project.data;
const full = variant === 'full';
const Heading = full ? 'h1' : 'h3';
const Sub = full ? 'h2' : 'h4';
const titleId = 'sheet-' + project.id;
const links = p.links.map((l) => ({ ...l, text: l.label ? t(l.label, lang) : s.linkLabels[l.kind] }));
const primary = links[0];
const sizes = '(min-width: 76rem) 52rem, (min-width: 56rem) 62vw, 100vw';
---
<article class:list={['sheet', `sheet--${variant}`]} aria-labelledby={titleId}>
  <div class="sheet__tabs" aria-hidden="true">
    <span class="sheet__tab mono">
      <svg viewBox="0 0 16 16" width="13" height="13"><path d="M3.5 1.5h6l3 3v10h-9z M9.5 1.5v3h3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
      {project.id}
    </span>
  </div>

  <div class="sheet__body">
    {p.image && (
      <figure class="sheet__figure">
        {primary ? (
          <a class="figure__media sheet__media" href={primary.url} aria-label={`${primary.text}: ${t(p.title, lang)} ${s.externalHint}`} data-sheet-trigger>
            <Image src={p.image.src} alt={t(p.image.alt, lang)} widths={[640, 960, 1400]} sizes={sizes} />
            <span class="sheet__open mono" aria-hidden="true"><Icon name={primary.kind === 'source' ? 'source' : 'website'} />{primary.text}</span>
          </a>
        ) : (
          <div class="figure__media sheet__media">
            <Image src={p.image.src} alt={t(p.image.alt, lang)} widths={[640, 960, 1400]} sizes={sizes} />
          </div>
        )}
        {p.image.caption && <figcaption class="figure__caption">{t(p.image.caption, lang)}</figcaption>}
      </figure>
    )}

    <header class="sheet__head">
      <Heading class="sheet__title" id={titleId}>
        {t(p.title, lang)}
        <span class="sheet__line" aria-hidden="true" data-sheet-line></span>
      </Heading>
      <p class="lead sheet__summary">{t(p.summary, lang)}</p>
    </header>

    {full && p.highlight && (
      <section class="sheet__block sheet__highlight" aria-labelledby={titleId + '-highlight'}>
        <Sub class="sheet__subtitle mono" id={titleId + '-highlight'}>{t(p.highlight.title, lang)}</Sub>
        <p class="prose">{t(p.highlight.body, lang)}</p>
      </section>
    )}

    {full && (p.context || p.work.length > 0) && (
      <div class="sheet__detail">
        {p.context && (
          <section class="sheet__block">
            <Sub class="sheet__subtitle mono">{s.context}</Sub>
            <p class="prose">{t(p.context, lang)}</p>
          </section>
        )}
        {p.work.length > 0 && (
          <section class="sheet__block">
            <Sub class="sheet__subtitle mono">{s.work}</Sub>
            <ul class="prose sheet__work">
              {p.work.map((w) => <li>{t(w, lang)}</li>)}
            </ul>
          </section>
        )}
      </div>
    )}

    {(p.stack.length > 0 || links.length > 0 || !full) && (
      <footer class="sheet__foot">
        <TechList items={p.stack} label={s.techLabel} />
        {(links.length > 0 || !full) && <ul class="link-list sheet__links">
          {links.map((l) => (
            <li>
              <a class="sheet__link" href={l.url}>
                <Icon name={l.kind === 'source' ? 'source' : 'website'} />
                {l.text}<span class="visually-hidden"> {s.externalHint}</span>
              </a>
            </li>
          ))}
          {!full && (
            <li><a href={projectUrl(lang, project.id)}>{s.openSheet}<span class="visually-hidden">: {t(p.title, lang)}</span></a></li>
          )}
        </ul>}
      </footer>
    )}
  </div>
</article>

<style>
  .sheet {
    min-width: 0;
    border: var(--rule);
    border-radius: 4px;
    background: var(--color-bg);
  }

  .sheet__tabs {
    display: flex;
    background: var(--color-surface);
    border-bottom: var(--rule);
    border-radius: 4px 4px 0 0;
    overflow: hidden;
  }

  .sheet__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: inset 0 2px 0 var(--color-accent);
    border-inline-end: var(--rule);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sheet__tab svg {
    flex: none;
    color: var(--color-accent);
  }

  .sheet__body {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5);
  }

  .sheet__media {
    aspect-ratio: 16 / 10;
  }

  .sheet__media {
    position: relative;
  }

  /* Contorno verde azulado separado de la vista previa por un pequeño margen en los cuatro lados */
  .sheet__media {
    box-shadow:
      0 0 0 5px var(--color-bg),
      0 0 0 6px var(--color-accent);
  }

  .sheet__figure {
    padding: 6px;
  }

  .sheet__media :global(img) {
    transform-origin: 50% 50%;
    object-position: top center;
  }

  /* Rótulo sobre la vista previa: indica que la imagen abre la web */
  .sheet__open {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 3px;
    background: var(--color-bg);
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  a.sheet__media:hover .sheet__open {
    color: var(--color-accent-strong);
  }

  a.sheet__media:focus-visible {
    outline-offset: 11px;
  }

  .sheet__title {
    position: relative;
    padding-bottom: var(--space-3);
    font-size: var(--text-h2);
    font-variation-settings: 'opsz' 48;
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .sheet--compact .sheet__title {
    font-size: var(--text-h3);
  }

  .sheet__line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 3rem;
    height: 2px;
    background: var(--color-accent);
    transform-origin: 0 50%;
  }

  .sheet__summary {
    margin-top: var(--space-4);
  }

  .sheet--compact .sheet__summary {
    font-size: var(--text-base);
    color: var(--color-text-soft);
  }

  .sheet__detail {
    display: grid;
    gap: var(--space-6);
  }

  .sheet__highlight {
    max-width: var(--measure);
    padding: var(--space-4) var(--space-5);
    border: var(--rule);
    border-radius: 4px;
    background: var(--color-surface);
  }

  .sheet__subtitle {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent);
  }

  .sheet__work {
    padding-left: 1.1em;
  }

  .sheet__work li + li {
    margin-top: var(--space-3);
  }

  .sheet__work li::marker {
    color: var(--color-accent);
  }

  .sheet__foot {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .sheet__body {
      padding: var(--space-6);
    }
  }

</style>
