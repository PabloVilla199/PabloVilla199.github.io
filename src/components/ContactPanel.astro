---
/**
 * Panel lateral de contacto (<dialog> modal). Lo abre el control «Contacto» de la barra
 * (src/scripts/ui.ts). Escape y «Cerrar» lo cierran; el foco vuelve al control que lo abrió.
 * Sin JavaScript el control enlaza al contacto del pie (#contacto).
 */
import type { CollectionEntry } from 'astro:content';
import ContactLinks from './ContactLinks.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile } = Astro.props;
const s = ui[lang];
const hasLinks = Object.values(profile.links).some(Boolean);
---
<dialog class="panel" id="contact-panel" aria-labelledby="contact-panel-title">
  <div class="panel__inner">
    <div class="panel__head">
      <p class="panel__tab mono" aria-hidden="true">{s.nav.contact.toLowerCase()}</p>
      <button type="button" class="panel__close mono" data-contact-close>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        {s.close}
      </button>
    </div>
    <div class="panel__body">
      <h2 class="panel__title" id="contact-panel-title">{s.contactTitle}</h2>
      <ContactLinks lang={lang} links={profile.links} />
      {!hasLinks && <p class="meta">{s.noLinks}</p>}
    </div>
  </div>
</dialog>

<style>
  .panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(26rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: var(--rule);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .panel::backdrop {
    background: rgb(6 18 16 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel[open] {
      animation: panel-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .panel[open]::backdrop {
      animation: fade-in 220ms ease-out;
    }
  }

  @keyframes panel-in {
    from { transform: translateX(1.5rem); opacity: 0; }
  }

  @keyframes fade-in {
    from { opacity: 0; }
  }

  .panel__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .panel__head {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: var(--bar-h);
    border-bottom: var(--rule);
  }

  .panel__tab {
    display: flex;
    align-items: center;
    padding-inline: var(--space-5);
    border-top: 2px solid var(--color-accent);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .panel__close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-5);
    border: 0;
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
  }

  .panel__close:hover {
    color: var(--color-text);
  }

  .panel__close:focus-visible {
    outline-offset: -4px;
  }

  .panel__body {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
  }

  .panel__title {
    font-size: var(--text-h2);
  }

  .panel__intro {
    color: var(--color-text-soft);
  }
</style>
