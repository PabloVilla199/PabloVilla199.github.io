---
/** /es/proyectos/<id>/: una página por proyecto de projects.json. */
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../views/ProjectPage.astro';
import { getProjects } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---
<ProjectPage lang="es" project={project} />
